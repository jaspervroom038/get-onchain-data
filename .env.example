# Server settings
HOST=0.0.0.0
PORT=8000

# Collection interval in seconds (default: 3600 = 1 hour)
COLLECT_INTERVAL_SECONDS=3600

# SQLite database file path
DB_PATH=onchain_metrics.db

# Google Sheets API sync (optional - leave empty to disable)
# Setup:
#   1. Create Google Cloud project: https://console.cloud.google.com
#   2. Enable Google Sheets API & Google Drive API
#   3. Create Service Account (IAM & Admin → Service Accounts)
#   4. Create JSON key and download it
#   5. Share your Google Sheet with the service account email
#   6. Set the paths below
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=OnChainMetrics
# Set to true to push full history to Google Sheets on startup
GOOGLE_SHEETS_ENABLE_BACKFILL_ON_STARTUP=false
